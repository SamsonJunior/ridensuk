rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && get(/databases/$(db)/documents/users/$(request.auth.uid)).data.role == 'admin'; }
    match /users/{id} {
      allow read: if signedIn() && (request.auth.uid == id || resource.data.role == 'rider' || isAdmin());
      allow create: if signedIn() && request.auth.uid == id
        && request.resource.data.role in ['passenger', 'rider']
        && request.resource.data.get('ver', false) == false;
      allow update: if isAdmin() || (signedIn() && request.auth.uid == id
        && request.resource.data.role == resource.data.role
        && request.resource.data.get('ver', false) == resource.data.get('ver', false));
    }
    match /rides/{id} {
      allow read: if signedIn() && (resource.data.pid == request.auth.uid || resource.data.rid == request.auth.uid || isAdmin());
      allow create: if signedIn() && request.resource.data.pid == request.auth.uid && request.resource.data.st == 'requested';
      allow update: if signedIn() && (resource.data.pid == request.auth.uid || resource.data.rid == request.auth.uid || isAdmin());
    }
  }
}
